{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/tdd_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking TDD guard"
          }
        ]
      }
    ]
  }
}
